# Application
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Open preserves existing behavior. Set invite_only on BOTH web and worker for
# a private pilot. CSV accepts explicit international numbers, max 100 entries.
# Empty/malformed invite config closes new enrollment; verified existing users
# and existing-account STOP/HELP/opt-out continue. This is not a total-seat cap.
# Keep the real list private; never use a NEXT_PUBLIC_ variable for it.
PILOT_ADMISSION_MODE=open
PILOT_INVITED_PHONES=
INTERVENTION_SHADOW_MODE=true
AUTONOMOUS_SENDING_ENABLED=false
CLEANUP_CHECKINS_ENABLED=false
# Optional operator-approved account UUIDs (CSV, max 20). Only these accounts
# may deliver proactively while global delivery is off; consent/safety gates remain.
PROACTIVE_CANARY_USER_IDS=
HYBRID_AI_REVIEW_ENABLED=true

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo

# Generate a 32-byte base64 key. Never reuse this value between environments.
FIELD_ENCRYPTION_KEY=

# Messaging (Sendblue is primary for the controlled sandbox demo)
MESSAGING_PROVIDER=sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_PHONE_NUMBER=
# Shared lines require the recipient to text the returned line before verification.
# Set dedicated only for the legacy dedicated-line contact verification API.
SENDBLUE_ONBOARDING_MODE=shared
SENDBLUE_API_BASE_URL=https://api.sendblue.com

# Optional Linq provider
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# Optional Twilio fallback (set MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ASSISTANT_WEB_SEARCH_ENABLED=true

# Worker
WORKER_ID=tempo-local-worker
WORKER_POLL_INTERVAL_MS=2000
