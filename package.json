{
  "name": "tempo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:ops",
    "build:ops": "tsc -p tsconfig.ops.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "context:report": "tsx scripts/context-report.ts",
    "beta:report": "tsx scripts/beta-report.ts",
    "demo:report": "tsx scripts/demo-report.ts",
    "smoke:staging": "tsx scripts/staging-smoke.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fontsource-variable/manrope": "latest",
    "@next/env": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "latest",
    "googleapis": "^176.0.0",
    "libphonenumber-js": "^1.13.11",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest",
    "tsx": "^4.23.12",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "^4.1.11"
  }
}
