{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "dist-ops",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "incremental": false
  },
  "include": ["scripts/migrate.ts", "src/server/config/**/*.ts", "src/server/db/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
